# ARC Bridge MCP — environment configuration.
# Copy to .env and fill in. NEVER commit .env (it is gitignored).
# Local mode needs NONE of these; live mode and OAuth need the marked ones.

# --- backend selection -------------------------------------------------
# "local" (default): zero-config file harness. "live": the real ARC mesh.
ARC_BRIDGE_BACKEND=local

# --- server binding ----------------------------------------------------
# Bind address. Keep 127.0.0.1 unless a reverse proxy fronts the server.
ARC_BRIDGE_HOST=127.0.0.1
# Port to serve on.
PORT=8765
# Local data directory for the file backend (./data default).
ARC_BRIDGE_DATA_DIR=./data
# Comma-separated extra allowed Origin values (DNS-rebinding defense).
# Loopback origins are always allowed; add your frontend origin(s) here.
ARC_BRIDGE_ALLOWED_ORIGINS=

# --- OAuth 2.1 front door (Alexa+ account linking) -----------------------
# "none" (default): /mcp is open. "oauth": bearer auth required on /mcp.
ARC_BRIDGE_AUTH=none
# Public base URL of this server (issuer + redirect target for OAuth).
# REQUIRED when ARC_BRIDGE_AUTH=oauth. Must be reachable by the client.
ARC_BRIDGE_PUBLIC_URL=http://127.0.0.1:8765

# --- live backend: Supabase (mesh tables) ------------------------------
# REQUIRED for ARC_BRIDGE_BACKEND=live.
ARC_SUPABASE_URL=
ARC_SUPABASE_KEY=

# --- live backend: Voice Monkey (Echo announcements) -------------------
# REQUIRED for arc_notify channel=echo in live mode.
VOICEMONKEY_TOKEN=
VOICEMONKEY_SPEAKER=

# --- live backend: Telegram (bot messages) -----------------------------
# REQUIRED for arc_notify channel=telegram in live mode.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- live backend: ntfy.sh (best-effort push) ---------------------------
# REQUIRED for arc_notify channel=ntfy in live mode.
NTFY_TOPIC=

# --- Nebius Token Factory: NVIDIA Nemotron model answers ----------------
# REQUIRED for Nemotron-written arc_ask answers (local backend). Without
# the key the server still runs: answers fall back to memory retrieval and
# every result states that no model call was made (fail-closed, no fakes).
TOKEN_FACTORY_API_KEY=
# Token Factory API root (OpenAI-compatible). Default shown; override only
# if Nebius moves the endpoint.
TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Nemotron model slug to request. API-list-confirmed Oct 28: the old 70B
# instruct is not offered, so the default is Nemotron-3-Nano-30B-A3B.
NEBIUS_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# --- Portkey gateway (revocable virtual key) -------------------------
# When BOTH are set, model calls route through the Portkey gateway instead
# of direct Token Factory calls. The virtual key is revocable without
# rotating the master Token Factory key, which is why the hosted demo uses
# this route. Portkey's free tier offers no budget control of its own, so
# the server-side spend cap below is the demo's stop.
PORTKEY_API_KEY=
PORTKEY_VIRTUAL_KEY=
# Portkey gateway root. Default shown; override only for tests.
PORTKEY_BASE_URL=https://api.portkey.ai/v1

# --- Server-side spend cap (model calls) -------------------------------
# Hard cap on estimated model spend: at the cap, chat() refuses and answers
# fall back to honest retrieval. Estimates use a conservative $1.00 per
# million tokens ceiling, so real spend stays below the estimate.
ARC_BRIDGE_SPEND_CAP_USD=5.00
ARC_BRIDGE_PRICE_PER_1M_USD=1.00
# Spend-state file (running totals, JSON). Outside the repo by default.
ARC_BRIDGE_SPEND_STATE_FILE=~/.arc-bridge-spend.json
